# 로컬 개발용 환경 변수. .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 수집(FRED)과 뉴스 분류(Vercel AI Gateway → TypeSafe Jev)
FRED_API_KEY=
AI_GATEWAY_API_KEY=

# Mac에서 파이프라인·API를 직접 실행할 때. 예: postgresql://coffee:<비밀번호>@127.0.0.1:5432/coffee
DATABASE_URL=

# docker compose (compose.yaml)
POSTGRES_PASSWORD=
WEB_PORT=8080

# 다른 출처의 프론트엔드가 API를 부를 때만 (쉼표로 구분)
CORS_ORIGINS=
