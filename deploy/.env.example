# Copy outside the repository and replace every placeholder.
POSTGRES_DB=coffee_price
POSTGRES_USER=coffee
POSTGRES_PASSWORD=replace_with_a_long_random_password
WEB_PORT=8080

# Absolute, VM-local directories. SOURCE_DIR may be empty only for collect.
SOURCE_DIR=/srv/coffee/seed
MODELS_DIR=/srv/coffee/models

# Required only by deploy.py collect. Do not put a real key in this example.
FRED_API_KEY=
