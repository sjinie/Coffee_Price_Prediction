# VM의 /srv/coffee/.env (저장소 밖, root만 읽기). 비밀번호는 `openssl rand -hex 32`로 만든다.
POSTGRES_ADMIN_PASSWORD=
COFFEE_PIPELINE_DB_PASSWORD=
COFFEE_API_DB_PASSWORD=
COFFEE_DB_NAME=coffee_v2
COFFEE_DOMAIN=
# 배포할 커밋. setup-db.sh를 실행할 때 COFFEE_SOURCE_SHA=$(git rev-parse --short HEAD)로 넘겨도 된다.
COFFEE_SOURCE_SHA=
